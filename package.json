{
  "name": "tree-sitter-delphi13",
  "version": "0.1.0",
  "description": "Tree-sitter grammar focused on Delphi 13 (RAD Studio 37.0)",
  "main": "bindings/node",
  "types": "bindings/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexl-git/tree-sitter-delphi13.git"
  },
  "keywords": [
    "parser",
    "tree-sitter",
    "delphi",
    "delphi13",
    "pascal"
  ],
  "homepage": "https://github.com/Alexl-git/tree-sitter-delphi13",
  "bugs": {
    "url": "https://github.com/Alexl-git/tree-sitter-delphi13/issues"
  },
  "author": "Alexander Liberov",
  "license": "MIT",
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.24.5"
  },
  "scripts": {
    "build": "tree-sitter generate && node-gyp build",
    "test": "tree-sitter test && tree-sitter parse examples/* --quiet --time",
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip"
  },
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.22.0"
  },
  "peerDependenciesMeta": {
    "tree_sitter": {
      "optional": true
    }
  }
}
